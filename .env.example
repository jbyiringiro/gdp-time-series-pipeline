# Copy this file to .env and change the values for your computer.
# .env is ignored by git, so your password is never pushed.

# MySQL (Task 2 setup script and Task 3 API)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=global_economy_db

# MongoDB (Task 2 setup script and Task 3 API)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=global_economy_db

# Where the Task 4 prediction script finds the Task 3 API
API_URL=http://localhost:8000
